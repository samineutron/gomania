---
/**
 * ============================================================================
 * QUÉ HACE:
 * Página principal de GoManía SpA. Actúa únicamente como ensamblador visual
 * (Composition Root) donde se montarán los módulos independientes uno por uno.
 *
 * QUÉ PUEDES EDITAR AQUÍ:
 * - Al completar cada paso modular (Pasos 3 al 7), importa aquí el componente
 *   `.astro` de ese módulo y colócalo dentro de su contenedor correspondiente.
 * - Nunca escribas lógica de negocio aquí; toda lógica vive en `src/features/`.
 *
 * CON QUÉ MÓDULO CONECTA:
 * - Usa `src/layouts/BaseLayout.astro`.
 * - Montará: `landing-shell`, `mix-builder`, `catalogo`, `carrito` y
 *   `checkout-whatsapp`.
 * ============================================================================
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND_CONFIG } from '../shared/config';
import Header from '../features/landing-shell/ui/Header.astro';
import Hero from '../features/landing-shell/ui/Hero.astro';
import QuienesSomos from '../features/landing-shell/ui/QuienesSomos.astro';
import Contacto from '../features/landing-shell/ui/Contacto.astro';
import Footer from '../features/landing-shell/ui/Footer.astro';
import CatalogoSection from '../features/catalogo/ui/CatalogoSection.astro';
import MixBuilderSection from '../features/mix-builder/ui/MixBuilderSection.astro';
import CarritoDrawer from '../features/carrito/ui/CarritoDrawer.astro';
// [PASO 7] Importar aquí CheckoutModal desde `checkout-whatsapp`
---

<BaseLayout>
  <!-- ========================================================================
       SLOT 1: HEADER (Módulo `landing-shell` — Paso 3)
       ======================================================================== -->
  <div id="slot-header" class="gm-module-slot" data-module="landing-shell:header">
    <Header />
  </div>

  <main id="contenido-principal">
    <!-- ======================================================================
         SLOT 2: HERO / PORTADA (Módulo `landing-shell` — Paso 3)
         ====================================================================== -->
    <section id="inicio" class="gm-module-slot" data-module="landing-shell:hero">
      <Hero />
      <div class="gm-container gm-skeleton-banner">
        <p class="gm-skeleton-badge">Esqueleto Base Listo — Astro 5 Static</p>
        <h1>{BRAND_CONFIG.shortName} · {BRAND_CONFIG.tagline}</h1>
        <p>
          Estructura modular preparada con 3 paletas intercambiables, EventBus
          tipado y configuración centralizada. Monta cada módulo en su contenedor.
        </p>
      </div>
    </section>

    <!-- ======================================================================
         SLOT 3: ARMADOR DE BOLSAS 80g–3kg (Módulo `mix-builder` — Paso 5)
         ====================================================================== -->
    <section id="armador-mix" class="gm-module-slot" data-module="mix-builder">
      <MixBuilderSection />
    </section>

    <!-- ======================================================================
         SLOT 4: CATÁLOGO Y FILTROS (Módulo `catalogo` — Paso 4)
         ====================================================================== -->
    <section id="catalogo" class="gm-module-slot" data-module="catalogo">
      <CatalogoSection />
    </section>

    <!-- ======================================================================
         SLOT 5: QUIÉNES SOMOS — HISTORIA USM (Módulo `landing-shell` — Paso 3)
         ====================================================================== -->
    <section id="quienes-somos" class="gm-module-slot" data-module="landing-shell:quienes-somos">
      <QuienesSomos />
    </section>

    <!-- ======================================================================
         SLOT 6: CONTACTO (Módulo `landing-shell` — Paso 3)
         ====================================================================== -->
    <section id="contacto" class="gm-module-slot" data-module="landing-shell:contacto">
      <Contacto />
    </section>
  </main>

  <!-- ========================================================================
       SLOT 7: FOOTER (Módulo `landing-shell` — Paso 3)
       ======================================================================== -->
  <div id="slot-footer" class="gm-module-slot" data-module="landing-shell:footer">
    <Footer />
  </div>

  <!-- ========================================================================
       SLOT 8: CARRITO DRAWER DESLIZABLE (Módulo `carrito` — Paso 6)
       ======================================================================== -->
  <div id="slot-carrito" class="gm-module-slot" data-module="carrito">
    <CarritoDrawer />
  </div>

  <!-- ========================================================================
       SLOT 9: MODAL CHECKOUT WHATSAPP (Módulo `checkout-whatsapp` — Paso 7)
       ======================================================================== -->
  <div id="slot-checkout" class="gm-module-slot" data-module="checkout-whatsapp">
    <!-- Montar <CheckoutModal /> aquí en el Paso 7 -->
  </div>
</BaseLayout>

<style>
  /* Estilos temporales solo para el aviso del esqueleto inicial.
     Se pueden eliminar en el Paso 3 al montar <Hero />. */
  .gm-skeleton-banner {
    margin-block: var(--space-8);
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    background: var(--bg-hero);
    color: var(--text-on-brand);
    box-shadow: var(--shadow-md);
    display: grid;
    gap: var(--space-3);
  }

  .gm-skeleton-badge {
    display: inline-block;
    width: fit-content;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--brand-sky);
    color: #ffffff;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .gm-skeleton-banner h1 {
    font-size: var(--text-hero);
  }
</style>
