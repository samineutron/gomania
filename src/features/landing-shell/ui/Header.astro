---
/**
 * ============================================================================
 * QUÉ HACE:
 * Renderiza el Header fijo en pantalla (`position: fixed`) con fondo en el
 * rosado principal de la marca (`var(--brand-pink)`):
 * - Izquierda: logo horizontal a color con área clickeable exacta al tamaño
 *   del logo (sin extenderse hasta el enlace "Inicio").
 * - Centro: navegación principal (`Inicio`, `Catálogo`, `Quiénes Somos`,
 *   `Contacto`), cada enlace clickeable solo sobre su propio botón.
 * - Derecha: botón de carrito con badge conectado al `EventBus`
 *   (`carrito:actualizado` / `carrito:abrirDrawer`) + menú hamburguesa móvil.
 *
 * QUÉ PUEDES EDITAR AQUÍ:
 * - Altura del header fijo: variable `--gm-header-height` en `<style>`.
 * - Logo definitivo a color: guárdalo en `public/images/brand/logo-horizontal-color.png`
 *   (o actualiza `BRAND_CONFIG.logoHorizontalUrl` en `src/shared/config.ts`).
 * - NUNCA reemplaces el logo por una versión en blanco y negro.
 *
 * CON QUÉ MÓDULO CONECTA:
 * - Lee `BRAND_CONFIG` desde `src/shared/config.ts`.
 * - Escucha `carrito:actualizado` y emite `carrito:abrirDrawer` mediante
 *   `src/shared/event-bus.ts` (contrato `src/contracts/events.contract.ts`).
 * ============================================================================
 */
import { BRAND_CONFIG } from '../../../shared/config';
import { NAV_ITEMS } from '../logic/landing-helpers';
---

<header class="gm-header" data-landing-header>
  <div class="gm-container gm-header__inner">
    <!-- ======================================================================
         BLOQUE 1 (IZQUIERDA): LOGO HORIZONTAL A COLOR
         Área clickeable ajustada estrictamente al logo (`width: fit-content`
         + `justify-self: start`).
         ====================================================================== -->
    <a href="#inicio" class="gm-header__brand" aria-label={`Ir al inicio de ${BRAND_CONFIG.name}`}>
      <img
        src={BRAND_CONFIG.logoHorizontalUrl}
        alt={BRAND_CONFIG.name}
        class="gm-header__logo-img"
        width="176"
        height="44"
        decoding="async"
        data-brand-logo-img
      />

      <!-- Placeholder temporal A COLOR (se oculta automáticamente cuando carga el PNG real) -->
      <span class="gm-header__logo-fallback" data-brand-logo-fallback aria-hidden="true">
        <svg
          width="168"
          height="42"
          viewBox="0 0 168 42"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
        >
          <rect x="1" y="2" width="38" height="38" rx="12" fill="#FFFFFF" stroke="#28AAE1" stroke-width="2" />
          <circle cx="31" cy="10" r="5" fill="#28AAE1" />
          <text
            x="20"
            y="26"
            text-anchor="middle"
            font-family="Fredoka, sans-serif"
            font-weight="700"
            font-size="13"
            fill="#F44870"
          >G&amp;M</text>
          <text
            x="48"
            y="24"
            font-family="Fredoka, sans-serif"
            font-weight="700"
            font-size="20"
            fill="currentColor"
          >GoManía</text>
          <text
            x="49"
            y="36"
            font-family="Plus Jakarta Sans, sans-serif"
            font-weight="700"
            font-size="8.5"
            letter-spacing="0.8"
            fill="currentColor"
            opacity="0.92"
          >GOMITAS &amp; MANÍ</text>
        </svg>
      </span>
    </a>

    <!-- ======================================================================
         BLOQUE 2 (CENTRO): NAVEGACIÓN PRINCIPAL (ESCRITORIO)
         ====================================================================== -->
    <nav class="gm-header__nav" aria-label="Navegación principal">
      <ul class="gm-header__nav-list">
        {NAV_ITEMS.map((item) => (
          <li>
            <a href={item.href} class="gm-header__nav-link">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- ======================================================================
         BLOQUE 3 (DERECHA): BOTÓN CARRITO CON BADGE + HAMBURGUESA MÓVIL
         ====================================================================== -->
    <div class="gm-header__actions">
      <button
        type="button"
        class="gm-cart-btn"
        aria-label="Abrir carrito de compras (0 productos)"
        data-header-cart-btn
      >
        <svg
          class="gm-cart-btn__icon"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="9" cy="20" r="1.5" />
          <circle cx="18" cy="20" r="1.5" />
          <path d="M2 3h3l2.2 11.2a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 1.9-1.5L22 7H6.2" />
        </svg>
        <span class="gm-cart-btn__label">Carrito</span>
        <span
          class="gm-cart-btn__badge"
          data-header-cart-badge
          aria-live="polite"
        >0</span>
      </button>

      <button
        type="button"
        class="gm-menu-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="gm-mobile-nav"
        data-menu-toggle
      >
        <svg
          class="gm-menu-toggle__icon gm-menu-toggle__icon--open"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.3"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="4" y1="6" x2="20" y2="6" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
        <svg
          class="gm-menu-toggle__icon gm-menu-toggle__icon--close"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.3"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- ========================================================================
       PANEL DESPLEGABLE MÓVIL ACCESIBLE
       ======================================================================== -->
  <nav
    id="gm-mobile-nav"
    class="gm-mobile-nav"
    aria-label="Navegación móvil"
    hidden
    data-mobile-nav
  >
    <ul class="gm-container gm-mobile-nav__list">
      {NAV_ITEMS.map((item) => (
        <li>
          <a href={item.href} class="gm-mobile-nav__link" data-mobile-nav-link>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  /**
   * Script cliente del Header:
   * 1) Gestiona el fallback visual del logo horizontal si el PNG aún no existe.
   * 2) Controla el menú hamburguesa accesible (clic, enlaces y tecla Escape).
   * 3) Conecta el botón de carrito con `eventBus` (`carrito:actualizado` y `carrito:abrirDrawer`).
   */
  import { eventBus } from '../../../shared/event-bus';

  const headerRoot = document.querySelector<HTMLElement>('[data-landing-header]');

  if (headerRoot) {
    // --- 1. Fallback limpio del logo horizontal a color ---
    const logoImg = headerRoot.querySelector<HTMLImageElement>('[data-brand-logo-img]');
    const logoFallback = headerRoot.querySelector<HTMLElement>('[data-brand-logo-fallback]');

    const showLogoFallback = (): void => {
      if (logoImg) logoImg.hidden = true;
      if (logoFallback) logoFallback.hidden = false;
    };

    const showLogoImage = (): void => {
      if (logoImg) logoImg.hidden = false;
      if (logoFallback) logoFallback.hidden = true;
    };

    if (logoImg && logoFallback) {
      if (logoImg.complete) {
        if (logoImg.naturalWidth > 0) {
          showLogoImage();
        } else {
          showLogoFallback();
        }
      } else {
        logoImg.addEventListener('load', showLogoImage, { once: true });
        logoImg.addEventListener('error', showLogoFallback, { once: true });
      }
    }

    // --- 2. Menú móvil hamburguesa accesible ---
    const menuToggle = headerRoot.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const mobileNav = headerRoot.querySelector<HTMLElement>('[data-mobile-nav]');
    const mobileLinks = headerRoot.querySelectorAll<HTMLAnchorElement>('[data-mobile-nav-link]');

    const setMenuOpen = (isOpen: boolean): void => {
      if (!menuToggle || !mobileNav) return;
      menuToggle.setAttribute('aria-expanded', String(isOpen));
      menuToggle.setAttribute(
        'aria-label',
        isOpen ? 'Cerrar menú de navegación' : 'Abrir menú de navegación'
      );
      mobileNav.hidden = !isOpen;
    };

    if (menuToggle && mobileNav) {
      menuToggle.addEventListener('click', () => {
        const currentlyOpen = menuToggle.getAttribute('aria-expanded') === 'true';
        setMenuOpen(!currentlyOpen);
      });

      mobileLinks.forEach((link) => {
        link.addEventListener('click', () => setMenuOpen(false));
      });

      document.addEventListener('keydown', (event: KeyboardEvent) => {
        if (event.key === 'Escape' && menuToggle.getAttribute('aria-expanded') === 'true') {
          setMenuOpen(false);
          menuToggle.focus();
        }
      });
    }

    // --- 3. Botón de carrito sincronizado por EventBus ---
    const cartBtn = headerRoot.querySelector<HTMLButtonElement>('[data-header-cart-btn]');
    const cartBadge = headerRoot.querySelector<HTMLElement>('[data-header-cart-badge]');

    if (cartBtn) {
      cartBtn.addEventListener('click', () => {
        eventBus.emit('carrito:abrirDrawer', { open: true });
      });
    }

    eventBus.on('carrito:actualizado', ({ totalItems }) => {
      const safeCount = Math.max(0, Math.floor(totalItems));
      if (cartBadge) {
        cartBadge.textContent = String(safeCount);
        cartBadge.classList.remove('is-pop');
        void cartBadge.offsetWidth;
        if (safeCount > 0) {
          cartBadge.classList.add('is-pop');
        }
      }
      if (cartBtn) {
        const label = safeCount === 1 ? '1 producto' : `${safeCount} productos`;
        cartBtn.setAttribute('aria-label', `Abrir carrito de compras (${label})`);
      }
    });
  }
</script>

<style>
  /* Variable global para compensar el header fijo al hacer scroll por anclas */
  :global(:root) {
    --gm-header-height: 68px;
  }

  :global(html) {
    scroll-padding-top: var(--gm-header-height);
  }

  /* Barra superior FIJA en pantalla con el rosado principal de la marca */
  .gm-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: var(--z-header, 100);
    background-color: var(--brand-pink);
    color: var(--cta-primary-text);
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: var(--shadow-md);
  }

  .gm-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--gm-header-height);
    padding-block: var(--space-2);
  }

  /* Marca izquierda: ancho ajustado EXACTAMENTE al logo (no invade el espacio hacia Inicio) */
  .gm-header__brand {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    max-width: max-content;
    min-height: var(--touch-min);
    flex-shrink: 0;
    color: var(--cta-primary-text);
    border-radius: var(--radius-sm);
  }

  .gm-header__logo-img {
    display: block;
    height: 42px;
    width: auto;
    object-fit: contain;
  }

  .gm-header__logo-fallback {
    display: inline-flex;
    align-items: center;
  }

  .gm-header__logo-fallback[hidden],
  .gm-header__logo-img[hidden] {
    display: none;
  }

  /* Navegación centrada (oculta en móvil, visible en >= 900px) */
  .gm-header__nav {
    display: none;
  }

  .gm-header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .gm-header__nav-link {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: var(--touch-min);
    padding-inline: var(--space-3);
    border-radius: var(--radius-pill);
    color: var(--cta-primary-text);
    font-weight: 700;
    font-size: var(--text-sm);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .gm-header__nav-link:hover {
    background-color: rgba(255, 255, 255, 0.22);
    color: var(--cta-primary-text);
  }

  /* Contenedor derecho (carrito + menú móvil) */
  .gm-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Botón de carrito con alto contraste sobre el header rosado */
  .gm-cart-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-min);
    padding: var(--space-2) var(--space-3);
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--radius-pill);
    background-color: var(--cta-primary);
    color: var(--cta-primary-text);
    font-weight: 700;
    font-size: var(--text-sm);
    box-shadow: var(--shadow-sm);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .gm-cart-btn:hover {
    background-color: var(--brand-sky-deep, #0B5E88);
    border-color: rgba(255, 255, 255, 0.8);
    box-shadow: 0 6px 16px rgba(11, 94, 136, 0.32);
    transform: translateY(-1px);
  }

  .gm-cart-btn__label {
    display: none;
  }

  .gm-cart-btn__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding-inline: var(--space-1);
    border-radius: var(--radius-pill);
    background-color: var(--brand-sky);
    color: var(--cta-primary-text);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .gm-cart-btn__badge.is-pop {
    animation: gm-badge-pop 280ms ease;
  }

  @keyframes gm-badge-pop {
    0% { transform: scale(1); }
    50% { transform: scale(1.25); }
    100% { transform: scale(1); }
  }

  /* Botón hamburguesa móvil (>= 44x44px) con alto contraste sobre rosado */
  .gm-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--touch-min);
    height: var(--touch-min);
    padding: 0;
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    border-radius: var(--radius-md);
    background-color: rgba(255, 255, 255, 0.16);
    color: var(--cta-primary-text);
    box-shadow: var(--shadow-sm);
  }

  .gm-menu-toggle__icon--close {
    display: none;
  }

  .gm-menu-toggle[aria-expanded='true'] .gm-menu-toggle__icon--open {
    display: none;
  }

  .gm-menu-toggle[aria-expanded='true'] .gm-menu-toggle__icon--close {
    display: block;
  }

  /* Menú desplegable móvil */
  .gm-mobile-nav {
    background-color: var(--bg-surface);
    color: var(--text-main);
    border-top: var(--border-width) solid var(--border-color);
    box-shadow: var(--shadow-md);
  }

  .gm-mobile-nav__list {
    list-style: none;
    margin: 0;
    padding-block: var(--space-3);
    display: grid;
    gap: var(--space-1);
  }

  .gm-mobile-nav__link {
    display: flex;
    align-items: center;
    min-height: var(--touch-min);
    padding-inline: var(--space-3);
    border-radius: var(--radius-md);
    color: var(--text-main);
    font-weight: 600;
    transition: background-color var(--transition-fast);
  }

  .gm-mobile-nav__link:hover {
    background-color: var(--bg-soft);
  }

  /* Responsive: etiqueta "Carrito" desde 480px */
  @media (min-width: 480px) {
    .gm-cart-btn__label {
      display: inline;
    }
  }

  /* Responsive: navegación centrada en escritorio (>= 900px) */
  @media (min-width: 900px) {
    .gm-header__inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }

    /* CLAVE: Evita que el link del logo se estire a todo el ancho de la columna 1fr */
    .gm-header__brand {
      justify-self: start;
    }

    .gm-header__nav {
      display: block;
      justify-self: center;
    }

    .gm-header__actions {
      justify-self: end;
    }

    .gm-menu-toggle,
    .gm-mobile-nav {
      display: none !important;
    }
  }
</style>
