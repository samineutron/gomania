---
/**
 * ============================================================================
 * QUÉ HACE:
 * Portada principal (Hero) de GoManía SpA a pantalla completa (`100dvw` x
 * `100dvh`):
 * - Fondo preparado para reproducir un video en bucle a pantalla completa
 *   (`public/videos/hero-bg.mp4`) cubierto por una capa blanca translúcida
 *   (`--hero-overlay-color`) que suaviza el fondo y garantiza lectura perfecta.
 * - Si aún no has subido el video de fondo, el script oculta la etiqueta
 *   `<video>` sin mostrar errores y deja el fondo rosado suave de respaldo.
 * - Diseño mobile-first; en escritorio (`>= 1024px`) muestra titular + lema +
 *   CTA a la izquierda y marco multimedia a la derecha.
 *
 * QUÉ PUEDES EDITAR AQUÍ:
 * - VIDEO DE FONDO: guarda tu video en `public/videos/hero-bg.mp4` (o cambia
 *   la ruta en el bloque `=== VIDEO DE FONDO DEL HERO (100dvw x 100dvh) ===`).
 * - CAPA BLANCA TRANSLÚCIDA: ajusta `--hero-overlay-color` (opacidad del
 *   blanco, por defecto `0.72`) y `--hero-overlay-blur` (desenfoque suave,
 *   por defecto `2px`) al inicio del bloque `<style>`.
 * - SLOT DERECHO: opcionalmente agrega una foto/video destacado en el bloque
 *   `=== SLOT RESERVADO PARA FOTO O VIDEO DEL HERO ===`.
 *
 * CON QUÉ MÓDULO CONECTA:
 * - Lee `BRAND_CONFIG` y `BUSINESS_RULES` desde `src/shared/config.ts`.
 * - Enlaza directamente con las secciones `#catalogo` y `#quienes-somos`.
 * ============================================================================
 */
import { BRAND_CONFIG, BUSINESS_RULES } from '../../../shared/config';
import Pouch3DViewer from './Pouch3DViewer.astro';
---

<div class="gm-hero" data-landing-hero>
  <!-- ========================================================================
       CAPA 0: VIDEO DE FONDO A PANTALLA COMPLETA (100dvw x 100dvh)
       INSTRUCCIÓN PARA ACTIVAR TU VIDEO DE FONDO:
       1. Guarda tu video MP4 liviano en: `public/videos/hero-bg.mp4`
          (recomendado: < 6 MB, sin audio, resolución 1280x720 o 1920x1080).
       2. Si quieres mostrar una imagen fija mientras carga el video, agrega
          el atributo `poster="/images/hero/hero-bg-poster.webp"`.
       3. Si el archivo todavía no existe, se oculta automáticamente y queda
          el fondo de respaldo con la capa translúcida blanca encima.
       ======================================================================== -->
  <div class="gm-hero__bg-media" aria-hidden="true">
    <video
      class="gm-hero__bg-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      data-hero-bg-video
    >
      <source src="/videos/hero-bg.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- ========================================================================
       CAPA 1: CAPA TRANSLÚCIDA BLANCA ENCIMA DEL VIDEO DE FONDO
       Edita su opacidad y desenfoque en `--hero-overlay-color` y
       `--hero-overlay-blur` dentro de `<style>`.
       ======================================================================== -->
  <div class="gm-hero__bg-overlay" aria-hidden="true"></div>

  <!-- ========================================================================
       CAPA 2: CONTENIDO PRINCIPAL DEL HERO (POR ENCIMA DEL VIDEO Y LA CAPA)
       ======================================================================== -->
  <div class="gm-container gm-hero__grid">
    <!-- COLUMNA IZQUIERDA (ARRIBA EN MÓVIL): TITULAR, LEMA Y CTA -->
    <div class="gm-hero__content">
      <span class="gm-hero__eyebrow">
        <span class="gm-hero__dot" aria-hidden="true"></span>
        {BRAND_CONFIG.tagline}
      </span>

      <h1 class="gm-hero__title">
        Arma tus bolsas de gomitas y maní por gramos
      </h1>

      <p class="gm-hero__subtitle">
        Elige desde una bolsita individual de <strong>80 g</strong> hasta mixes de
        <strong>3 kg</strong> con tus sabores dulces, ácidos o salados favoritos.
        {BUSINESS_RULES.shippingNote}
      </p>

      <div class="gm-hero__actions">
        <a href="#catalogo" class="gm-hero__cta">
          Explorar catálogo
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        </a>

        <a href="#quienes-somos" class="gm-hero__secondary">
          Nuestra historia
        </a>
      </div>

      <ul class="gm-hero__highlights" aria-label="Beneficios principales">
        <li class="gm-hero__pill">80 g a 3 kg</li>
        <li class="gm-hero__pill">Gomitas y Maní</li>
        <li class="gm-hero__pill">Envío {BUSINESS_RULES.shippingCarrier}</li>
      </ul>
    </div>

    <!-- COLUMNA DERECHA (ABAJO EN MÓVIL): VISOR 3D INTERACTIVO DEL EMPAQUE -->
    <div class="gm-hero__media-wrap">
      <div class="gm-hero__media-frame" data-hero-media-frame>
        <!-- Aquí empieza el modelo 3d envase gomanía
             Props configurables:
             - showControls={false} : oculta la barra inferior de botones
             - showHint={true}      : muestra/oculta la pista superior "Arrastra para girar 360°..."
             - transparent={true}   : fondo transparente + oculta visualmente la card contenedora -->
        <Pouch3DViewer showControls={false} showHint={true} transparent={false}>
          <div slot="fallback" class="gm-hero__fallback" data-hero-fallback>
            <div class="gm-hero__fallback-badge">Vista previa del empaque</div>

            <!-- Ilustración decorativa a color estilo GoManía (nunca B/N) -->
            <svg
              class="gm-hero__fallback-art"
              viewBox="0 0 320 220"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              role="img"
              aria-label="Ilustración decorativa de bolsas y sabores GoManía SpA"
            >
              <rect x="16" y="16" width="288" height="188" rx="28" fill="#FFFFFF" fill-opacity="0.92" />
              <circle cx="72" cy="70" r="28" fill="#FFE5EC" />
              <circle cx="248" cy="152" r="34" fill="#E6F7FE" />
              <!-- Bolsa Doypack estilizada a color -->
              <rect x="108" y="34" width="104" height="148" rx="18" fill="#F44870" />
              <rect x="118" y="46" width="84" height="10" rx="5" fill="#FFFFFF" fill-opacity="0.35" />
              <!-- Ventana central transparente simulada -->
              <rect x="122" y="84" width="76" height="64" rx="14" fill="#FFF2F5" stroke="#FFFFFF" stroke-width="3" />
              <!-- Gomitas y maníes de colores dentro de la ventana -->
              <circle cx="144" cy="112" r="11" fill="#28AAE1" />
              <circle cx="164" cy="122" r="12" fill="#F44870" />
              <circle cx="178" cy="106" r="10" fill="#C89D70" />
              <circle cx="152" cy="130" r="8" fill="#15803D" />
              <!-- Sello G&M en esquina superior izquierda -->
              <circle cx="130" cy="68" r="13" fill="#28AAE1" stroke="#FFFFFF" stroke-width="2" />
              <text
                x="130"
                y="72"
                text-anchor="middle"
                font-family="Fredoka, sans-serif"
                font-weight="700"
                font-size="9"
                fill="#FFFFFF"
              >G&amp;M</text>
              <text
                x="160"
                y="170"
                text-anchor="middle"
                font-family="Fredoka, sans-serif"
                font-weight="700"
                font-size="13"
                fill="#FFFFFF"
              >GoManía</text>
            </svg>

            <p class="gm-hero__fallback-caption">
              {BRAND_CONFIG.shortName} · {BRAND_CONFIG.tagline}
            </p>
          </div>
        </Pouch3DViewer>
        <!-- Aquí termina el modelo 3d envase gomanía -->
      </div>
    </div>
  </div>
</div>

<script>
  /**
   * Manejo seguro de medios del Hero:
   * 1) Video de fondo (`data-hero-bg-video`): si todavía no subes
   *    `public/videos/hero-bg.mp4` o falla su carga, lo oculta limpiamente
   *    manteniendo el fondo de respaldo con la capa translúcida blanca.
   * 2) Tarjeta derecha (`data-hero-media`): activa fallback si falla la carga.
   */
  const heroRoot = document.querySelector<HTMLElement>('[data-landing-hero]');

  if (heroRoot) {
    // --- 1. Video de fondo full-bleed (100dvw x 100dvh) ---
    const bgVideo = heroRoot.querySelector<HTMLVideoElement>('[data-hero-bg-video]');
    const bgSource = bgVideo?.querySelector<HTMLSourceElement>('source');

    if (bgVideo) {
      const hideBgVideo = (): void => {
        bgVideo.hidden = true;
      };
      const showBgVideo = (): void => {
        bgVideo.hidden = false;
      };

      bgVideo.addEventListener('loadeddata', showBgVideo, { once: true });
      bgVideo.addEventListener('error', hideBgVideo, { once: true });
      bgSource?.addEventListener('error', hideBgVideo, { once: true });
    }

    // --- 2. Fallback del slot multimedia derecho ---
    const mediaEl = heroRoot.querySelector<HTMLImageElement | HTMLVideoElement>('[data-hero-media]');
    const fallbackEl = heroRoot.querySelector<HTMLElement>('[data-hero-fallback]');

    if (mediaEl && fallbackEl) {
      const activateFallback = (): void => {
        mediaEl.hidden = true;
        fallbackEl.classList.remove('is-hidden');
      };

      const activateMedia = (): void => {
        mediaEl.hidden = false;
        fallbackEl.classList.add('is-hidden');
      };

      if (mediaEl instanceof HTMLImageElement) {
        if (mediaEl.complete) {
          if (mediaEl.naturalWidth > 0) activateMedia();
          else activateFallback();
        } else {
          mediaEl.addEventListener('load', activateMedia, { once: true });
          mediaEl.addEventListener('error', activateFallback, { once: true });
        }
      } else {
        mediaEl.addEventListener('loadeddata', activateMedia, { once: true });
        mediaEl.addEventListener('error', activateFallback, { once: true });
      }
    }
  }
</script>

<style>
  /* Contenedor principal del Hero: pantalla completa 100dvw x 100dvh */
  .gm-hero {
    /* EDITABLE: Opacidad y desenfoque de la capa translúcida blanca sobre el video */
    --hero-overlay-color: rgba(255, 255, 255, 0.72);
    --hero-overlay-blur: 2px;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100dvw;
    max-width: 100%;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    background-color: var(--bg-hero);
    color: var(--text-main);
    /* Espacio superior seguro para que el Header fijo nunca tape el contenido */
    padding-top: calc(var(--gm-header-height, 68px) + var(--space-8));
    padding-bottom: var(--space-12);
    border-bottom: var(--border-width) solid var(--border-color);
  }

  /* CAPA 0: Video de fondo cubriendo el 100% del Hero */
  .gm-hero__bg-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
  }

  .gm-hero__bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .gm-hero__bg-video[hidden] {
    display: none;
  }

  /* CAPA 1: Velo translúcido blanco encima del video */
  .gm-hero__bg-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: var(--hero-overlay-color);
    backdrop-filter: blur(var(--hero-overlay-blur));
    -webkit-backdrop-filter: blur(var(--hero-overlay-blur));
    pointer-events: none;
  }

  /* CAPA 2: Contenido principal por encima del velo blanco */
  .gm-hero__grid {
    position: relative;
    z-index: 2;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .gm-hero__content {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  /* Píldora superior con el lema "Más de 100 sabores" */
  .gm-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background-color: var(--bg-surface);
    color: var(--brand-pink-dark);
    border: var(--border-width) solid var(--border-color);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    box-shadow: var(--shadow-sm);
  }

  .gm-hero__dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pill);
    background-color: var(--brand-sky);
  }

  /* Titular en alto contraste sobre la capa translúcida blanca */
  .gm-hero__title {
    font-size: var(--text-hero);
    font-weight: 700;
    color: var(--text-main);
    max-width: 16ch;
  }

  .gm-hero__subtitle {
    font-size: var(--text-lg);
    color: var(--text-main);
    max-width: 52ch;
    opacity: 0.9;
  }

  /* Botonera CTA mobile-first (zona del pulgar >= 44px) */
  .gm-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .gm-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-pill);
    background-color: var(--cta-primary);
    color: var(--cta-primary-text);
    border: var(--border-width) solid var(--border-color);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    box-shadow: var(--shadow-md);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .gm-hero__cta:hover {
    background-color: var(--cta-primary-hover);
    transform: translateY(-2px);
  }

  .gm-hero__secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-pill);
    background-color: var(--bg-surface);
    color: var(--text-main);
    border: var(--border-width) solid var(--border-color);
    font-weight: 700;
    font-size: var(--text-sm);
    box-shadow: var(--shadow-sm);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .gm-hero__secondary:hover {
    background-color: var(--brand-sky-soft);
    transform: translateY(-1px);
  }

  /* Chips informativos rápidos */
  .gm-hero__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
  }

  .gm-hero__pill {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background-color: var(--brand-sky-soft);
    color: var(--text-main);
    border: var(--border-width) solid var(--border-color);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .gm-hero__pill:nth-child(1) {
    background-color: var(--brand-pink-soft);
    color: var(--brand-pink-dark);
  }

  .gm-hero__pill:nth-child(2) {
    background-color: var(--candy-lilac-bg, #EDE9FE);
    color: var(--candy-lilac-text, #5B21B6);
  }

  .gm-hero__pill:nth-child(3) {
    background-color: var(--candy-mint-bg, #D1FAE5);
    color: var(--candy-mint-text, #065F46);
  }

  /* Marco contenedor del visor 3D del envase GoManía */
  .gm-hero__media-wrap {
    width: 100%;
  }

  .gm-hero__media-frame {
    position: relative;
    width: 100%;
    height: 440px;
    min-height: 440px;
    border-radius: var(--radius-xl);
    background-color: #ffffff;
    color: var(--text-main);
    border: var(--border-width) solid var(--border-color);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  /* Cuando Pouch3DViewer tiene `transparent={true}`, oculta visualmente la card
     manteniendo el marco limpio por si se activa el fallback sin WebGL */
  :global(.gm-hero__media-frame[data-hero-media-frame]:has([data-pouch3d-transparent="true"])) {
    background-color: transparent;
    border-color: transparent;
    box-shadow: none;
  }

  :global(.gm-hero__media-frame[data-hero-media-frame]:has([data-pouch3d-fallback]:not([hidden]))) {
    background-color: rgba(255, 255, 255, 0.92);
    border: var(--border-width) solid var(--border-color);
    box-shadow: var(--shadow-lg);
  }

  .gm-hero__media-asset {
    width: 100%;
    height: 100%;
    min-height: 320px;
    max-height: 440px;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .gm-hero__fallback {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    text-align: center;
    width: 100%;
  }

  .gm-hero__fallback.is-hidden {
    display: none;
  }

  .gm-hero__fallback-badge {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background-color: var(--brand-pink-soft);
    color: var(--brand-pink-dark);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .gm-hero__fallback-art {
    width: min(100%, 320px);
    height: auto;
  }

  .gm-hero__fallback-caption {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-muted);
  }

  /* Escritorio (>= 1024px): 2 columnas — texto a la izquierda, media a la derecha */
  @media (min-width: 1024px) {
    .gm-hero {
      padding-top: calc(var(--gm-header-height, 68px) + var(--space-12));
      padding-bottom: var(--space-12);
    }

    .gm-hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-12);
    }

    .gm-hero__media-frame {
      height: 520px;
      min-height: 520px;
    }
  }
</style>
