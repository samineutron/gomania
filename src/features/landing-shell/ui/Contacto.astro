---
/**
 * ============================================================================
 * QUÉ HACE:
 * Sección de contacto directo ubicada inmediatamente encima del Footer.
 * Muestra acceso rápido a WhatsApp, correo corporativo y aviso claro de
 * despacho por Blue Express por pagar al recibir o retirar.
 *
 * QUÉ PUEDES EDITAR AQUÍ:
 * - No necesitas editar teléfono ni correo aquí: cámbialos en `SOCIAL_LINKS`
 *   y `BUSINESS_RULES` dentro de `src/shared/config.ts`.
 *
 * CON QUÉ MÓDULO CONECTA:
 * - Lee `SOCIAL_LINKS` y `BUSINESS_RULES` desde `src/shared/config.ts`.
 * - Usa `buildWhatsAppContactUrl` y `formatChilePhoneDisplay` desde
 *   `../logic/landing-helpers.ts`.
 * ============================================================================
 */
import { BUSINESS_RULES, SOCIAL_LINKS } from '../../../shared/config';
import {
  buildWhatsAppContactUrl,
  formatChilePhoneDisplay,
} from '../logic/landing-helpers';

const whatsappHref = buildWhatsAppContactUrl(SOCIAL_LINKS.whatsappNumber);
const whatsappDisplay = formatChilePhoneDisplay(SOCIAL_LINKS.whatsappNumber);
---

<div class="gm-contact">
  <div class="gm-container">
    <div class="gm-contact__header" data-reveal>
      <span class="gm-contact__badge">Atención directa</span>
      <h2 class="gm-contact__title">¿Tienes dudas o un pedido especial?</h2>
      <p class="gm-contact__lead">
        Escríbenos directamente y te ayudamos a armar tus bolsas de gomitas y maní.
      </p>
    </div>

    <div class="gm-contact__grid">
      <!-- Tarjeta 1: WhatsApp directo -->
      <article class="gm-contact__card" data-reveal>
        <div class="gm-contact__icon gm-contact__icon--wa" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.4 8.4 0 0 1-12.5 7.3L3 20l1.3-5.2A8.4 8.4 0 1 1 21 11.5Z" />
          </svg>
        </div>
        <h3 class="gm-contact__card-title">WhatsApp directo</h3>
        <p class="gm-contact__card-text">
          Consultas de sabores, eventos o coordinación rápida de tu pedido.
        </p>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="gm-contact__cta"
        >
          Escribir a {whatsappDisplay}
        </a>
      </article>

      <!-- Tarjeta 2: Correo corporativo -->
      <article class="gm-contact__card" data-reveal>
        <div class="gm-contact__icon gm-contact__icon--mail" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
        </div>
        <h3 class="gm-contact__card-title">Correo electrónico</h3>
        <p class="gm-contact__card-text">
          Ideal para compras mayoristas, cotizaciones de empresas o seguimiento.
        </p>
        <a href={`mailto:${SOCIAL_LINKS.email}`} class="gm-contact__link">
          {SOCIAL_LINKS.email}
        </a>
      </article>

      <!-- Tarjeta 3: Envíos Blue Express por pagar -->
      <article class="gm-contact__card" data-reveal>
        <div class="gm-contact__icon gm-contact__icon--ship" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 7h11v10H3z" />
            <path d="M14 10h4l3 3v4h-7z" />
            <circle cx="7.5" cy="17.5" r="2" />
            <circle cx="17.5" cy="17.5" r="2" />
          </svg>
        </div>
        <h3 class="gm-contact__card-title">Despacho {BUSINESS_RULES.shippingCarrier}</h3>
        <p class="gm-contact__card-text">
          {BUSINESS_RULES.shippingNote}
        </p>
        <span class="gm-contact__note">Despachos a todo Chile</span>
      </article>
    </div>
  </div>
</div>

<style>
  .gm-contact {
    padding-block: var(--space-12);
    background-color: var(--bg-canvas);
  }

  .gm-contact__header {
    display: grid;
    gap: var(--space-2);
    text-align: center;
    justify-items: center;
    margin-bottom: var(--space-8);
  }

  .gm-contact__badge {
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-pill);
    background-color: var(--brand-pink-soft);
    color: var(--brand-pink-dark);
    border: var(--border-width) solid var(--border-color);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .gm-contact__title {
    font-size: var(--text-3xl);
    color: var(--text-main);
  }

  .gm-contact__lead {
    color: var(--text-muted);
    max-width: 52ch;
  }

  .gm-contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  .gm-contact__card {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    background-color: var(--bg-surface);
    border: var(--border-width) solid var(--border-color);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .gm-contact__card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .gm-contact__card:nth-child(1):hover {
    border-color: var(--state-success);
  }

  .gm-contact__card:nth-child(2):hover {
    border-color: var(--brand-pink);
  }

  .gm-contact__card:nth-child(3):hover {
    border-color: var(--brand-sky);
  }

  .gm-contact__icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: grid;
    place-items: center;
    border: var(--border-width) solid var(--border-color);
    transition: transform 240ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .gm-contact__card:hover .gm-contact__icon {
    transform: scale(1.08) rotate(-4deg);
  }

  .gm-contact__icon--wa {
    background-color: var(--state-success-bg);
    color: var(--state-success);
  }

  .gm-contact__icon--mail {
    background-color: var(--brand-pink-soft);
    color: var(--brand-pink-dark);
  }

  .gm-contact__icon--ship {
    background-color: var(--brand-sky-soft);
    color: var(--brand-sky-dark);
  }

  .gm-contact__card-title {
    font-size: var(--text-xl);
    color: var(--text-main);
  }

  .gm-contact__card-text {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .gm-contact__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background-color: var(--cta-primary);
    color: var(--cta-primary-text);
    font-weight: 700;
    font-size: var(--text-sm);
    width: fit-content;
    transition: background-color var(--transition-fast);
  }

  .gm-contact__cta:hover {
    background-color: var(--cta-primary-hover);
  }

  .gm-contact__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    color: var(--brand-sky-dark);
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .gm-contact__note {
    display: inline-block;
    width: fit-content;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background-color: var(--brand-sky-soft);
    color: var(--brand-sky-dark);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .gm-contact__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
